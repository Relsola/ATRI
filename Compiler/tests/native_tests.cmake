# 名称、可见性及初始化错误必须由编译器诊断，不拖到链接阶段。
foreach(case private collision duplicate duplicate_open constant_write runtime_init missing)
    if(case STREQUAL "private")
        set(expected "unknown function name")
    elseif(case STREQUAL "constant_write")
        set(expected "cannot assign")
    elseif(case STREQUAL "runtime_init")
        set(expected "runtime global")
    elseif(case STREQUAL "missing")
        set(expected "cannot resolve")
    else()
        set(expected "duplicate")
    endif()
    execute_process(COMMAND "${COMPILER}" -S "${SOURCE_DIR}/tests/cases/modules/${case}.ar"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${status}" STREQUAL "1" OR NOT err MATCHES "${expected}")
        message(FATAL_ERROR "Module diagnostic ${case} (${status})\n${out}\n${err}")
    endif()
endforeach()

function(expect_compile_error source expected)
    execute_process(COMMAND "${COMPILER}" -S "${SOURCE_DIR}/${source}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${status}" STREQUAL "1" OR NOT err MATCHES "${expected}")
        message(FATAL_ERROR "Compile diagnostic ${source} (${status})\n${out}\n${err}")
    endif()
endfunction()
