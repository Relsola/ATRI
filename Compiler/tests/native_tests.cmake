file(MAKE_DIRECTORY "${OUTPUT_DIR}")

function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "Command failed (${status}): ${ARGV}\n${out}\n${err}")
    endif()
endfunction()

function(expect_exit executable expected)
    execute_process(COMMAND "${executable}" ${ARGN} RESULT_VARIABLE actual OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${executable}\nExpected exit: ${expected}\nActual exit: ${actual}\n${out}\n${err}")
    endif()
endfunction()

function(expect_stdout executable expected)
    # 写文件后按字节读取，验证 UTF-8 数据而不依赖终端当前代码页。
    set(output "${executable}.stdout")
    execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_FILE "${output}" ERROR_VARIABLE err
        WORKING_DIRECTORY "${SOURCE_DIR}" TIMEOUT 10)
    file(READ "${output}" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT "${status}" STREQUAL "0" OR NOT "${actual}" STREQUAL "${expected}" OR NOT "${err}" STREQUAL "")
        message(FATAL_ERROR "${executable}\nExit: ${status}\nExpected stdout:\n${expected}\nActual stdout:\n${actual}\nStderr:\n${err}")
    endif()
endfunction()

function(expect_function_assembly assembly symbol pattern)
    file(READ "${assembly}" text)
    string(FIND "${text}" "\n${symbol}:" start)
    if(start LESS 0)
        message(FATAL_ERROR "${assembly}: ${symbol} was not emitted")
    endif()
    # 相同指令也可能出现在其他函数，只匹配这个符号到自己的 .seh_endproc。
    string(SUBSTRING "${text}" ${start} -1 body)
    string(FIND "${body}" ".seh_endproc" end)
    if(end LESS 0)
        message(FATAL_ERROR "${assembly}: ${symbol} has no end marker")
    endif()
    string(SUBSTRING "${body}" 0 ${end} body)
    if(NOT body MATCHES "${pattern}")
        message(FATAL_ERROR "${assembly} / ${symbol}\nExpected pattern: ${pattern}\nActual assembly:\n${body}")
    endif()
endfunction()

function(expect_direct_return assembly expected)
    expect_function_assembly("${assembly}" main "main:[\r\n ]+\\.seh_endprologue[\r\n ]+mov eax, ${expected}[\r\n ]+ret")
endfunction()

function(expect_library_assembly harness name pattern)
    file(READ "${OUTPUT_DIR}/${harness}_bindings.h" bindings)
    if(NOT bindings MATCHES "#define atri_test_${name} (atri_fn_[0-9]+)[\r\n]")
        message(FATAL_ERROR "${harness}: missing generated binding for ${name}")
    endif()
    expect_function_assembly("${OUTPUT_DIR}/${harness}-${level}.s" "${CMAKE_MATCH_1}" "${pattern}")
endfunction()

function(expect_function_count assembly expected)
    file(READ "${assembly}" text)
    string(REGEX MATCHALL "[\r\n]\\.seh_proc [^\r\n]+" definitions "${text}")
    list(LENGTH definitions actual)
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "${assembly}\nExpected function definitions: ${expected}\nActual: ${actual}\n${definitions}")
    endif()
endfunction()

function(run_program source expected)
    get_filename_component(name "${source}" NAME_WE)
    set(assembly "${OUTPUT_DIR}/${name}-${level}.s")
    set(executable "${OUTPUT_DIR}/${name}-${level}.exe")
    run_checked("${COMPILER}" "-${level}" -S -o "${assembly}" "${SOURCE_DIR}/${source}")
    run_checked("${CLANG}" "${assembly}" -o "${executable}")
    if(ARGC GREATER 2)
        expect_stdout("${executable}" "${ARGV2}")
    else()
        expect_exit("${executable}" "${expected}")
    endif()
endfunction()

function(run_library source harness)
    get_filename_component(name "${harness}" NAME_WE)
    set(bindings "${OUTPUT_DIR}/${name}_bindings.h")
    set(assembly "${OUTPUT_DIR}/${name}-${level}.s")
    set(executable "${OUTPUT_DIR}/${name}-${level}.exe")
    run_checked("${BINDINGS_GENERATOR}" "${SOURCE_DIR}/${source}" "${bindings}")
    run_checked("${COMPILER}" "-${level}" -S -o "${assembly}" "${SOURCE_DIR}/${source}")
    run_checked("${CLANG}" -std=c23 "${assembly}" "${SOURCE_DIR}/tests/${harness}"
        "-I${OUTPUT_DIR}" "-I${SOURCE_DIR}/tests" -o "${executable}")
    expect_exit("${executable}" 0 ${ARGN})
endfunction()

