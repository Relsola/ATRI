file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "Command failed (${status}): ${ARGV}\n${out}\n${err}")
    endif()
endfunction()

run_checked("${COMPILER}" --emit-ir "${SOURCE_DIR}/examples/main.txt")
execute_process(COMMAND "${COMPILER}" --emit-ir "${SOURCE_DIR}/examples/main.txt"
    RESULT_VARIABLE status OUTPUT_VARIABLE ir ERROR_VARIABLE err)
if(NOT ir MATCHES "const i32 3" OR NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Expected folded constant 3: ${ir}\n${err}")
endif()
foreach(level O0 O1)
    set(assembly "${OUTPUT_DIR}/main-${level}.s")
    set(executable "${OUTPUT_DIR}/main-${level}.exe")
    run_checked("${COMPILER}" "-${level}" -S -o "${assembly}" "${SOURCE_DIR}/examples/main.txt")
    file(READ "${assembly}" text)
    if(level STREQUAL "O1" AND NOT text MATCHES "main:[\r\n ]+\.seh_endprologue[\r\n ]+mov eax, 3[\r\n ]+ret")
        message(FATAL_ERROR "main should directly return 3: ${text}")
    endif()
    run_checked("${CLANG}" "${assembly}" -o "${executable}")
    execute_process(COMMAND "${executable}" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "3")
        message(FATAL_ERROR "Expected main exit code 3, got ${result}")
    endif()

    set(assembly "${OUTPUT_DIR}/library-${level}.s")
    set(executable "${OUTPUT_DIR}/library-${level}.exe")
    run_checked("${COMPILER}" "-${level}" -S -o "${assembly}" "${SOURCE_DIR}/tests/cases/arithmetic_library.txt")
    run_checked("${CLANG}" "${assembly}" "${SOURCE_DIR}/tests/native_harness.c" -o "${executable}")
    run_checked("${executable}")
endforeach()
