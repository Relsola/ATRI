mem :: import "std::mem";
import "std::list";
text :: import "std::string";

struct Counts { grows: i32; frees: i32; fail: bool; }

fn resize(state: *void, old: *void, old_size: u64, size: u64) -> *void {
    counts: *Counts = cast(*Counts, state);
    if (size == 0) { (*counts).frees += 1; }
    else {
        if ((*counts).fail) { return null; }
        (*counts).grows += 1;
    }
    return mem::c_resize(state, old, old_size, size);
}

fn put(items: *list(i32), n: i32) -> bool { return append(items, n); }

fn exercise() -> i32 {
    counts: Counts;
    custom: mem::Context = {.allocator = {.proc = &resize, .state = cast(*void, &counts)}};
    items: list(i32);
    {
        context: *mem::Context = &custom;
        if (!put(&items, 7)) { return 1; }
    }
    if (counts.grows != 1 || (*context).allocator.proc != null) { return 2; }
    while (items.len < items.cap) { if (!put(&items, 9)) { return 3; } }
    old: *i32 = items.data;
    count: u64 = items.len;
    counts.fail = true;
    if (put(&items, 1) || items.data != old || items.len != count || items.cap != count) { return 4; }
    counts.fail = false;
    // The source element is inside the allocation that may move.
    if (!append(&items, *items.data)) { return 5; }
    if (*(items.data + cast(i64, count)) != 7 || counts.grows != 2) { return 6; }
    release(&items);
    release(&items);
    if (items.len != 0 || items.data != null || counts.frees != 1) { return 7; }
    labels: list(string);
    defer release(&labels);
    if (!append(&labels, "a\0b") || !text::equal(*labels.data, "a\0b")) { return 8; }
    bytes: list(u8);
    {
        context: *mem::Context = &custom;
        if (!text::concat("a", "b", &bytes) || counts.grows != 3) { return 9; }
        counts.fail = true;
        if (text::concat(text::view(&bytes), "c", &bytes) || !text::equal(text::view(&bytes), "ab")) { return 10; }
    }
    release(&bytes);
    if (counts.frees != 2) { return 11; }
    return 0;
}

fn generated() -> *u8 {
    if (exercise() == 0) { return "0"; }
    return "1";
}

fn keep(state: *void, old: *void, old_size: u64, size: u64) -> *void { return old; }

fn callback_source() -> string {
    proc: *mem::ResizeProc = &keep;
    if (proc(null, null, 0, 0) == null) { return "1"; }
    return "0";
}

fn main() -> i32 {
    if (#insert #run callback_source() != 1) { return 21; }
    if (#insert #run generated() != 0) { return 20; }
    vm: i32 = #run exercise();
    if (vm != 0) { return vm + 10; }
    return exercise();
}
