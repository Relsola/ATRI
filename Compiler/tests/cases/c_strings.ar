#extern(C) fn puts(text: *u8) -> i32;

fn returned_literal() -> *u8 {
    return "returned literal";
}

fn main() -> i32 {
    puts("");
    puts("line1\nline2");
    puts("\"quoted\"\\tab\t\x41");
    puts("你好");
    puts("before\0after");
    puts("0suffix" + 1);
    puts(returned_literal());
    return 0;
}
