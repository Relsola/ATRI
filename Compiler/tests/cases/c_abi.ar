#extern(C) fn c_probe(text: *u8, wide: i64, tag: i32, object: *i32, tail: *u8, last: i64) -> i64;
#extern(C) fn c_text() -> *u8;
#extern(C) fn c_identity(text: *u8) -> *u8;
#extern(C) fn c_bool(value: i32) -> bool;
#extern(C) fn c_bump(object: *i32) -> i32;

fn call_c(object: *i32, wide: i64, last: i64) -> i64 {
    return c_probe("ATRI", wide, -7, object, "tail", last);
}

fn observe_c_write(object: *i32) -> i32 {
    before: i32 = *object;
    c_bump(object);
    return *object - before;
}

fn from_c() -> *u8 {
    return c_text();
}

fn round_trip(text: *u8) -> *u8 {
    return c_identity(text);
}

fn negate_c_bool(value: i32) -> bool {
    return !c_bool(value);
}

fn static_text() -> *u8 {
    return "static text";
}

fn char_offset(text: *u8, offset: i64) -> *u8 {
    return text + offset;
}

fn char_offset32(text: *u8, offset: i32) -> *u8 {
    return offset + text;
}

fn char_distance(left: *u8, right: *u8) -> i64 {
    return left - right;
}

fn default_char_null() -> *u8 {
    text: *u8;
    return text;
}

fn choose_text(flag: bool) -> *u8 {
    text: *u8;
    if (flag) {
        text = "chosen";
    }
    return text;
}
