struct B1 { a: bool; }
struct B2 { a: bool; b: bool; }
struct B3 { a: bool; b: bool; c: bool; }
struct I4 { a: i32; }
struct Pair { a: i32; b: i32; }
struct Big { a: i64; b: i64; c: i64; }
struct Nested { small: Pair; big: Big; }
struct Mixed { a: i32; flag: bool; pointer: *i32; }
fn same1(v: B1) -> B1 { return v; }
fn same2(v: B2) -> B2 { return v; }
fn same3(v: B3) -> B3 { return v; }
fn same4(v: I4) -> I4 { return v; }
fn same8(v: Pair) -> Pair { return v; }
fn same_mixed(v: Mixed) -> Mixed { return v; }
fn adjust(v: Big, a: i64, b: i64, c: i64, d: i64, e: i64) -> Big {
    result: Big = v;
    result.a = result.a + a + d;
    result.b = result.b + b + e;
    result.c = result.c + c;
    return result;
}
fn nested(v: Nested) -> Nested {
    result: Nested = v;
    result.small.a = 42;
    result.big.c = 77;
    return result;
}
#extern(C) fn c_change(v: Big, n: i32, wide: i64, pair: Pair, pointer: *i32, flag: bool) -> Big;
#extern(C) fn c_independent(a: Big, b: Big) -> i64;
fn independent(v: Big) -> i64 { return c_independent(v, v); }
fn call_c() -> i32 {
    value: Big = {.a = 1, .b = 2, .c = 3};
    target: i32 = 4;
    result: Big = c_change(value, 5, 7, {.a = 8, .b = 9}, &target, true);
    if (result.a != 6 || result.b != 9 || result.c != 25 || target != 6 || value.a != 1) { return 1; }
    return 0;
}
fn combine(a: Big, b: Big, pair: Pair, mixed: Mixed, end: i64) -> Big {
    if (pair.a != 7 || mixed.a != 8 || !mixed.flag || *mixed.pointer != 9 || end != 11) { return {.a = -1}; }
    return {.a = a.a + b.a, .b = a.b + b.b, .c = a.c + b.c};
}
