// 基础整数的动态参数用于验证真实机器运算和窄指针读写。

fn add_i8(a: i8, b: i8) -> i8 {
    return a + b;
}
fn divide_i8(a: i8, b: i8) -> i8 {
    return a / b;
}
fn remainder_i8(a: i8, b: i8) -> i8 {
    return a % b;
}
fn bits_i8(a: i8, b: i8, count: u64) -> i8 {
    return ((~a) & b) ^ (a << count) | (b >> count);
}
fn write_i8(p: *i8, value: i8) -> i8 {
    *p = value;
    return *p;
}
fn step_i8(p: *i8, count: i64) -> *i8 {
    cursor: *i8 = p;
    cursor += count;
    cursor -= 1;
    return cursor;
}
fn distance_i8(p: *i8, q: *i8) -> i64 {
    return p - q;
}
fn widen_i8(value: i8) -> u64 {
    return cast(u64, value);
}

