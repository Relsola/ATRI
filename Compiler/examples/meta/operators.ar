compiler :: import "std::compiler";
import "std::list";
text :: import "std::string";

fn register() -> i32 {
    if (compiler::register_annotation("math") == 0) { return 1; }
    if (compiler::register_infix("math", "%%", 19, 0) == 0) { return 1; }
    return 0;
}

fn replace_sum(node: u64) -> bool {
    left: string = compiler::ast_to_code(compiler::ast_operand(node, 0));
    right: string = compiler::ast_to_code(compiler::ast_operand(node, 1));
    if (left.data == null || right.data == null) { return false; }
    parts: [5]string = {"(", left, ") + (", right, ")"};
    code: list(u8);
    defer release(&code);
    if (!text::join(&parts[0], 5, &code)) { return false; }
    return compiler::code_to_ast(node, text::view(&code)) != 0;
}

fn message(decl: u64, kind: u32, module: *u8, name: *u8, source: *u8,
           replacement: **u8, injection: **u8) -> i32 {
    if (compiler::ast_has_annotation(decl, "math") == 0) { return 0; }
    i: u64 = 0;
    while (i < compiler::ast_expression_count(decl)) {
        node: u64 = compiler::ast_expression(decl, i);
        op: string = compiler::ast_operator(node);
        if (op.data == null) { return 1; }
        if (text::equal(op, "%%")) {
            if (!replace_sum(node)) { return 1; }
            i = 0;
        } else { i += 1; }
    }
    return 0;
}
